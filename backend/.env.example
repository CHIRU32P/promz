# DECONSTRUCT AI Engine - Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with your credentials

# Google Gemini API Key (obtained from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use for video multimodal analysis
# Supported options include: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
